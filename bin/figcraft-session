#!/bin/bash
# Dispatch the on-demand FigCraft launcher to the platform implementation.
#
#   macOS   launchd job
#   Linux   detached process with a pid file
#   Windows PowerShell: bin/figcraft-session.ps1
set -u

HERE="$(cd "$(dirname "$0")" && pwd)"

case "$(uname -s)" in
  Darwin)
    exec "$HERE/figcraft-session-macos" "$@"
    ;;
  Linux)
    exec "$HERE/figcraft-session-linux" "$@"
    ;;
  *)
    printf 'dsh-figcraft uses this launcher on macOS and Linux.\n' >&2
    printf 'On Windows, run bin\\figon.cmd or bin\\figcraft-session.ps1.\n' >&2
    exit 1
    ;;
esac
